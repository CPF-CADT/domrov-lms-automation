PORT=3001
DATABASE_URL=postgresql://domrov_auth:change-me@localhost:5432/auth_db
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=20h
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_REFRESH_EXPIRES_IN=7d
# Required for registration, resend and password-reset mail delivery.
# Example for host-run Mailpit; use the container DNS name inside Docker.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
AUTH_CORS_ORIGIN=http://localhost:5173

NODE_ENV=development

# Required in every environment. Generate locally with: openssl rand -hex 32
# Paste the output into your untracked .env; never reuse either JWT secret.
OTP_HASH_SECRET=

# RabbitMQ — local host development only
RABBITMQ_URL=amqp://domrov:domrov@localhost:5672/%2f
RABBITMQ_AUTH_QUEUE=auth-commands
RABBITMQ_AUTH_EVENTS_QUEUE=auth-events
RABBITMQ_EVENTS_EXCHANGE=domrov.events

# Email behavior
# OTP delivery failures always fail verification-email operations and roll back issuance.
# Password-reset requests keep their generic public response on delivery failure.

# Frontend callback
FRONTEND_URL=http://localhost:5173

# Optional OAuth providers. Configure all three values for each enabled provider.
# Use externally reachable callback URLs through your gateway.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3001/auth/github/callback
# Legacy aliases: GIT_HUB_CLIENT_ID, GIT_HUB_CLIENT_SECRET, GIT_HUB_CALLBACK_URL.
# Legacy SMTP_PASS is accepted when SMTP_PASSWORD is unset (not an empty value).
