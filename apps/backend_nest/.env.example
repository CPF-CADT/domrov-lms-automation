# Local EBS storage. Resource.url remains a relative storage key.
LOCAL_FILE_ROOT=/data/files
MAX_FILE_SIZE_BYTES=262144000
MAX_STORAGE_QUOTA_BYTES=0
MIN_FREE_SPACE_BYTES=1073741824

# R2 variables are only required while explicitly migrating legacy r2 rows.
# New uploads and evaluations must not depend on them.
