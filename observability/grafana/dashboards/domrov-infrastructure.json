{
  "title": "DOMROV — Infrastructure",
  "uid": "domrov-infrastructure",
  "description": "Compose container resources, databases, message queues and telemetry health.",
  "schemaVersion": 41,
  "version": 3,
  "editable": false,
  "tags": [
    "domrov",
    "local"
  ],
  "timezone": "browser",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "refresh": "30s",
  "links": [
    {
      "title": "System Overview",
      "type": "link",
      "url": "/d/domrov-overview",
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "Microservices",
      "type": "link",
      "url": "/d/domrov-microservices",
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "id": 11,
      "type": "table",
      "title": "Current metrics by service",
      "description": "CPU and network rates use the last five minutes. RAM is the latest working set. Total sums the reported values for all monitored Compose services. A dash means no sample was available.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "expr": "label_replace(\n  (sum by (compose_service) (rate(container_cpu_usage_seconds_total{job=\"cadvisor\",compose_service!=\"\"}[5m])))\n  or label_replace(sum(sum by (compose_service) (rate(container_cpu_usage_seconds_total{job=\"cadvisor\",compose_service!=\"\"}[5m]))), \"compose_service\", \"Total\", \"__name__\", \".*\"),\n  \"metric\", \"CPU\", \"__name__\", \".*\"\n)\nor\nlabel_replace(\n  (sum by (compose_service) (container_memory_working_set_bytes{job=\"cadvisor\",compose_service!=\"\"}) / 1048576)\n  or label_replace(sum(sum by (compose_service) (container_memory_working_set_bytes{job=\"cadvisor\",compose_service!=\"\"}) / 1048576), \"compose_service\", \"Total\", \"__name__\", \".*\"),\n  \"metric\", \"RAM\", \"__name__\", \".*\"\n)\nor\nlabel_replace(\n  (sum by (compose_service) (rate(container_network_receive_bytes_total{job=\"cadvisor\",compose_service!=\"\",interface!=\"lo\"}[5m])) / 1000)\n  or label_replace(sum(sum by (compose_service) (rate(container_network_receive_bytes_total{job=\"cadvisor\",compose_service!=\"\",interface!=\"lo\"}[5m])) / 1000), \"compose_service\", \"Total\", \"__name__\", \".*\"),\n  \"metric\", \"Network RX\", \"__name__\", \".*\"\n)\nor\nlabel_replace(\n  (sum by (compose_service) (rate(container_network_transmit_bytes_total{job=\"cadvisor\",compose_service!=\"\",interface!=\"lo\"}[5m])) / 1000)\n  or label_replace(sum(sum by (compose_service) (rate(container_network_transmit_bytes_total{job=\"cadvisor\",compose_service!=\"\",interface!=\"lo\"}[5m])) / 1000), \"compose_service\", \"Total\", \"__name__\", \".*\"),\n  \"metric\", \"Network TX\", \"__name__\", \".*\"\n)",
          "format": "table",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": {
            "rowField": "compose_service",
            "columnField": "metric",
            "valueField": "Value",
            "emptyValue": "null"
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "compose_service\\metric": 0,
              "compose_service": 0,
              "CPU": 1,
              "RAM": 2,
              "Network RX": 3,
              "Network TX": 4
            },
            "renameByName": {
              "compose_service\\metric": "Service",
              "compose_service": "Service"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "—"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "CPU"
            },
            "properties": [
              {
                "id": "unit",
                "value": "suffix: cores"
              },
              {
                "id": "decimals",
                "value": 3
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "RAM"
            },
            "properties": [
              {
                "id": "unit",
                "value": "suffix: MiB"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Network RX"
            },
            "properties": [
              {
                "id": "unit",
                "value": "suffix: kB/s"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Network TX"
            },
            "properties": [
              {
                "id": "unit",
                "value": "suffix: kB/s"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Service",
            "desc": false
          }
        ]
      }
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "Container CPU usage by service",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (compose_service) (rate(container_cpu_usage_seconds_total{job=\"cadvisor\",compose_service!=\"\"}[$__rate_interval]))",
          "legendFormat": "{{compose_service}}",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: cores",
          "min": 0,
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Container RAM working set by service",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (compose_service) (container_memory_working_set_bytes{job=\"cadvisor\",compose_service!=\"\"}) / 1048576",
          "legendFormat": "{{compose_service}}",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: MiB",
          "min": 0,
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Network receive by service",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (compose_service) (rate(container_network_receive_bytes_total{job=\"cadvisor\",compose_service!=\"\",interface!=\"lo\"}[$__rate_interval]))",
          "legendFormat": "{{compose_service}}",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0,
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Network transmit by service",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (compose_service) (rate(container_network_transmit_bytes_total{job=\"cadvisor\",compose_service!=\"\",interface!=\"lo\"}[$__rate_interval]))",
          "legendFormat": "{{compose_service}}",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0,
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "PostgreSQL availability",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pg_up{job=\"domrov-postgres\"}",
          "instant": true,
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down",
                  "color": "red"
                },
                "1": {
                  "text": "Up",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "RabbitMQ queue depth",
      "description": "Ready and unacknowledged messages aggregated across the broker.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rabbitmq_queue_messages_ready)",
          "legendFormat": "Ready",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "sum(rabbitmq_queue_messages_unacked)",
          "legendFormat": "Unacknowledged",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "RabbitMQ client and worker p95 latency",
      "description": "Publish and process duration from instrumented applications.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (service_name, le) (rate(messaging_client_operation_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{service_name}} publish",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (service_name, le) (rate(messaging_process_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{service_name}} process",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Pending and firing alerts",
      "description": "Only alerts currently pending or firing appear here.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (alertname, alertstate) (ALERTS{alertstate=~\"pending|firing\"})",
          "legendFormat": "{{alertname}} {{alertstate}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Scrape target availability",
      "description": "Up means Prometheus fetched metrics successfully. It measures the scrape endpoint.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 44,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up",
          "legendFormat": "{{job}} {{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Failed trace export spans per second",
      "description": "A sustained increase indicates the collector cannot send spans to Tempo.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 44,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (exporter) (rate(otelcol_exporter_send_failed_spans_total[$__rate_interval]))",
          "legendFormat": "{{exporter}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Host root filesystem available",
      "description": "Free space available to non-root users on the Compose host. Docker Desktop reports the Linux VM filesystem. A low-space alert fires below 15% for 10 minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 52,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * node_filesystem_avail_bytes{job=\"domrov-host\",mountpoint=\"/\"} / node_filesystem_size_bytes{job=\"domrov-host\",mountpoint=\"/\"}",
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      }
    }
  ]
