{
  "title": "DOMROV — System Overview",
  "uid": "domrov-overview",
  "description": "Readiness, traffic, errors and latency across the five DOMROV backends.",
  "schemaVersion": 41,
  "version": 2,
  "editable": false,
  "tags": [
    "domrov",
    "local"
  ],
  "timezone": "browser",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "refresh": "30s",
  "links": [
    {
      "title": "Infrastructure",
      "type": "link",
      "url": "/d/domrov-infrastructure",
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "Microservices",
      "type": "link",
      "url": "/d/domrov-microservices",
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "Application logs",
      "type": "link",
      "url": "/d/domrov-logs",
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "id": 13,
      "type": "stat",
      "title": "Backends ready",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(probe_success{job=\"domrov-http\",service=~\"user|academic-service|payment-service|evaluation-service|code-execution\"})",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: / 5",
          "min": 0,
          "noValue": "No data",
          "decimals": 0
        },
        "overrides": []
      },
      "description": "Successful HTTP readiness probes across the five backend services.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "none",
        "colorMode": "none"
      }
    },
    {
      "id": 14,
      "type": "stat",
      "title": "Requests per second",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum (rate(http_server_request_duration_seconds_count{job=\"domrov-otel\",service_name=~\"user|academic-service|payment-service|evaluation-service|code-execution\"}[$__rate_interval]))",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "none",
        "colorMode": "none"
      }
    },
    {
      "id": 15,
      "type": "stat",
      "title": "HTTP 5xx rate",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum (rate(http_server_request_duration_seconds_count{job=\"domrov-otel\",service_name=~\"user|academic-service|payment-service|evaluation-service|code-execution\",http_response_status_code=~\"5..\"}[$__rate_interval])) or 0 * sum (rate(http_server_request_duration_seconds_count{job=\"domrov-otel\",service_name=~\"user|academic-service|payment-service|evaluation-service|code-execution\"}[$__rate_interval]))) / (sum (rate(http_server_request_duration_seconds_count{job=\"domrov-otel\",service_name=~\"user|academic-service|payment-service|evaluation-service|code-execution\"}[$__rate_interval])) > 0)",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "noValue": "No data"
        },
        "overrides": []
      },
      "description": "Server errors as a share of backend requests. An interval without traffic has no ratio.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "none",
        "colorMode": "none"
      }
    },
    {
      "id": 16,
      "type": "stat",
      "title": "P95 latency",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"domrov-otel\",service_name=~\"user|academic-service|payment-service|evaluation-service|code-execution\"}[$__rate_interval]))) * 1000) >= 0",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "none",
        "colorMode": "none"
      }
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests by service",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name) (rate(http_server_request_duration_seconds_count{job=\"domrov-otel\",service_name=~\"user|academic-service|payment-service|evaluation-service|code-execution\"}[$__rate_interval]))",
          "legendFormat": "{{service_name}}",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP errors by status class",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum (rate(http_server_request_duration_seconds_count{job=\"domrov-otel\",service_name=~\"user|academic-service|payment-service|evaluation-service|code-execution\",http_response_status_code=~\"4..\"}[$__rate_interval])) or 0 * sum (rate(http_server_request_duration_seconds_count{job=\"domrov-otel\",service_name=~\"user|academic-service|payment-service|evaluation-service|code-execution\"}[$__rate_interval]))",
          "legendFormat": "HTTP 4xx",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "sum (rate(http_server_request_duration_seconds_count{job=\"domrov-otel\",service_name=~\"user|academic-service|payment-service|evaluation-service|code-execution\",http_response_status_code=~\"5..\"}[$__rate_interval])) or 0 * sum (rate(http_server_request_duration_seconds_count{job=\"domrov-otel\",service_name=~\"user|academic-service|payment-service|evaluation-service|code-execution\"}[$__rate_interval]))",
          "legendFormat": "HTTP 5xx",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "P95 latency by service",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(histogram_quantile(0.95, sum by (service_name, le) (rate(http_server_request_duration_seconds_bucket{job=\"domrov-otel\",service_name=~\"user|academic-service|payment-service|evaluation-service|code-execution\"}[$__rate_interval]))) * 1000) >= 0",
          "legendFormat": "{{service_name}}",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Backend network traffic",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum (rate(container_network_receive_bytes_total{job=\"cadvisor\",compose_service=~\"user|academic-service|payment-service|evaluation-service|code-execution\",interface!=\"lo\"}[$__rate_interval]))",
          "legendFormat": "Receive",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "sum (rate(container_network_transmit_bytes_total{job=\"cadvisor\",compose_service=~\"user|academic-service|payment-service|evaluation-service|code-execution\",interface!=\"lo\"}[$__rate_interval]))",
          "legendFormat": "Transmit",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0,
          "noValue": "No data"
        },
        "overrides": []
      },
      "description": "Sum of non-loopback traffic observed by the five backend containers.",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ]
}
