{
  "title": "DOMROV — Microservices",
  "uid": "domrov-microservices",
  "description": "Readiness, latency and HTTP errors for a selected backend.",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "tags": [
    "domrov",
    "local"
  ],
  "timezone": "browser",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "refresh": "30s",
  "links": [
    {
      "title": "System Overview",
      "type": "link",
      "url": "/d/domrov-overview",
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "Infrastructure",
      "type": "link",
      "url": "/d/domrov-infrastructure",
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "Logs for selected service",
      "type": "link",
      "url": "/d/domrov-logs?var-service=${service:percentencode}",
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Service readiness",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_success{job=\"domrov-http\",service=\"$service\"}",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "noValue": "No data",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Not ready",
                  "color": "red"
                },
                "1": {
                  "text": "Ready",
                  "color": "green"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "none",
        "colorMode": "value"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Requests per second",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum (rate(http_server_request_duration_seconds_count{job=\"domrov-otel\",service_name=\"$service\"}[$__rate_interval]))",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "none",
        "colorMode": "none"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "P95 latency",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"domrov-otel\",service_name=\"$service\"}[$__rate_interval]))) * 1000) >= 0",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "none",
        "colorMode": "none"
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "HTTP errors",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum (rate(http_server_request_duration_seconds_count{job=\"domrov-otel\",service_name=\"$service\",http_response_status_code=~\"4..\"}[$__rate_interval])) or 0 * sum (rate(http_server_request_duration_seconds_count{job=\"domrov-otel\",service_name=\"$service\"}[$__rate_interval]))",
          "legendFormat": "HTTP 4xx",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "sum (rate(http_server_request_duration_seconds_count{job=\"domrov-otel\",service_name=\"$service\",http_response_status_code=~\"5..\"}[$__rate_interval])) or 0 * sum (rate(http_server_request_duration_seconds_count{job=\"domrov-otel\",service_name=\"$service\"}[$__rate_interval]))",
          "legendFormat": "HTTP 5xx",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "HTTP 5xx rate over time",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum (rate(http_server_request_duration_seconds_count{job=\"domrov-otel\",service_name=\"$service\",http_response_status_code=~\"5..\"}[$__rate_interval])) or 0 * sum (rate(http_server_request_duration_seconds_count{job=\"domrov-otel\",service_name=\"$service\"}[$__rate_interval]))) / (sum (rate(http_server_request_duration_seconds_count{job=\"domrov-otel\",service_name=\"$service\"}[$__rate_interval])) > 0)",
          "legendFormat": "5xx share",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "P95 latency over time",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"domrov-otel\",service_name=\"$service\"}[$__rate_interval]))) * 1000) >= 0",
          "legendFormat": "P95",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "custom",
        "query": "user,academic-service,payment-service,evaluation-service,code-execution",
        "current": {
          "text": "user",
          "value": "user",
          "selected": true
        },
        "options": [
          {
            "text": "user",
            "value": "user",
            "selected": true
          },
          {
            "text": "academic-service",
            "value": "academic-service",
            "selected": false
          },
          {
            "text": "payment-service",
            "value": "payment-service",
            "selected": false
          },
          {
            "text": "evaluation-service",
            "value": "evaluation-service",
            "selected": false
          },
          {
            "text": "code-execution",
            "value": "code-execution",
            "selected": false
          }
        ]
      }
    ]
  }
}
