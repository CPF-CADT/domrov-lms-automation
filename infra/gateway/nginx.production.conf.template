error_log stderr warn;

events {}

http {
  map $http_origin $client_cors_origin {
    default "";
    "${AUTH_CORS_ORIGIN}" $http_origin;
  }

  map $http_origin $cors_origin {
    default $client_cors_origin;
    "${ADMIN_CORS_ORIGIN}" $http_origin;
  }

  include /etc/nginx/mime.types;
  resolver 127.0.0.11 valid=10s ipv6=off;

  upstream user_service { zone user_service 64k; server user:3001 resolve; }
  upstream academic_service { zone academic_service 64k; server academic-service:3002 resolve; }
  upstream payment_service { zone payment_service 64k; server payment-service:3003 resolve; }
  upstream evaluation_service { zone evaluation_service 64k; server evaluation-service:3004 resolve; }

  map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
  }

  map $proxy_host $log_upstream_route {
    default other;
    user_service user;
    academic_service academic;
    payment_service payment;
    evaluation_service evaluation;
  }

  map $uri $log_route {
    default $log_upstream_route;
    /health health;
  }

  map $request_method $log_method {
    default OTHER;
    GET GET;
    HEAD HEAD;
    POST POST;
    PUT PUT;
    PATCH PATCH;
    DELETE DELETE;
    OPTIONS OPTIONS;
  }

  map $status $log_level {
    default info;
    ~^4 warn;
    ~^5 error;
  }

  map $status $log_status {
    default 0;
    ~^[1-5][0-9][0-9]$ $status;
  }

  map "$log_route:$status" $log_request {
    default 1;
    ~^health:[23] 0;
  }

  log_format safe_json escape=json
    '{"timestamp":"$time_iso8601","level":"$log_level","service":"gateway",'
    '"event":"http.request.completed","message":"Gateway request completed",'
    '"request_id":"$request_id","correlation_id":"$request_id",'
    '"status_code":$log_status,"http_method":"$log_method","route":"$log_route",'
    '"upstream_status":"$upstream_status","duration_seconds":$request_time}';

  access_log /dev/stdout safe_json if=$log_request;

  server {
    listen 80 default_server;
    server_name _;
    error_log /dev/null;
    location = /health { return 200; }
    location / { return 404; }
  }

  server {
    listen 80;
    server_name ${API_HOST};
    client_max_body_size 50m;
    # Nginx request diagnostics can include raw URLs, headers, and client addresses.
    # The safe access log records request failures and upstream status instead.
    error_log /dev/null;

    add_header Access-Control-Allow-Origin $cors_origin always;
    add_header Access-Control-Allow-Credentials "true" always;
    add_header Access-Control-Allow-Methods "GET, POST, PATCH, PUT, DELETE, OPTIONS" always;
    add_header Access-Control-Allow-Headers "Authorization, Content-Type, Idempotency-Key, X-Requested-With, Cache-Control, Pragma, Expires" always;
    add_header Access-Control-Expose-Headers "X-Request-ID" always;
    if ($request_method = OPTIONS) { return 204; }

    location = /health {
      add_header Content-Type application/json;
      return 200 '{"status":"ok","service":"gateway"}';
    }

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Request-ID $request_id;
    proxy_set_header X-Correlation-ID $request_id;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_hide_header Access-Control-Allow-Origin;
    proxy_hide_header Access-Control-Allow-Credentials;
    proxy_hide_header Access-Control-Allow-Methods;
    proxy_hide_header Access-Control-Allow-Headers;
    proxy_hide_header Access-Control-Expose-Headers;
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;

    location ^~ /auth { proxy_pass http://user_service; }
    location ^~ /users { proxy_pass http://user_service; }

    location ~ ^/(class|team|assessments|submissions|file)(/|$) {
      rewrite ^/(class|team|assessments|submissions|file)(/|$)(.*)$ /api/academic/$1/$3 break;
      proxy_pass http://academic_service;
    }

    location ^~ /wallet { proxy_pass http://payment_service; }
    location = /credit-packages { proxy_pass http://payment_service; }
    location ^~ /payment { proxy_pass http://payment_service; }
    location ^~ /evaluations/submission/ { rewrite ^/evaluations/submission/(.*)$ /api/academic/executions/submission/$1 break; proxy_pass http://academic_service; }
    location ^~ /evaluations { proxy_pass http://evaluation_service; }
    location ^~ /user-ai { proxy_pass http://evaluation_service; }
    location ~ ^/(api/academic/)?executions/?$ {
      default_type application/json;
      if ($request_method = POST) { return 503 '{"message":"Code execution is unavailable on this deployment"}'; }
      rewrite ^/executions/?$ /api/academic/executions break;
      proxy_pass http://academic_service;
    }
    location ^~ /execution-runs {
      default_type application/json;
      return 503 '{"message":"Code execution is unavailable on this deployment"}';
    }
    location /executions/ { rewrite ^/executions/(.*)$ /api/academic/executions/$1 break; proxy_pass http://academic_service; }

    location ^~ /notifications { proxy_pass http://user_service; }
    location ^~ /admin/users { proxy_pass http://user_service; }
    location ^~ /admin/wallet { proxy_pass http://payment_service; }
    location = /admin/dashboard { rewrite ^ /api/academic/admin/dashboard break; proxy_pass http://academic_service; }
    location ^~ /admin/dashboard/ { rewrite ^/admin/dashboard/(.*)$ /api/academic/admin/dashboard/$1 break; proxy_pass http://academic_service; }
    location ^~ /admin/evaluations { proxy_pass http://evaluation_service; }
    location ^~ /admin/usage { proxy_pass http://evaluation_service; }
    location ^~ /admin/logs { proxy_pass http://evaluation_service; }

    location ^~ /socket.io/ { proxy_pass http://payment_service; proxy_buffering off; }

    location ^~ /api/auth { proxy_pass http://user_service; }
    location ^~ /api/users { proxy_pass http://user_service; }
    location /api/academic { proxy_pass http://academic_service; }
    location ^~ /api/payment { proxy_pass http://payment_service; }
    location ^~ /api/ai { proxy_pass http://evaluation_service; }

    location / {
      default_type application/json;
      return 404 '{"statusCode":404,"message":"Gateway route not found"}';
    }
  }
  server {
    listen 80;
    server_name ${CLIENT_HOST};
    access_log off;
    error_log /dev/null;
    root /srv/domrov/client;
    location / { try_files $uri $uri/ /index.html =404; }
    location = /runtime-config.js {
      alias /var/run/domrov/runtime-config.js;
      default_type application/javascript;
      add_header Cache-Control "no-store" always;
    }
  }

  server {
    listen 80;
    server_name ${ADMIN_HOST};
    access_log off;
    error_log /dev/null;
    root /srv/domrov/admin;
    location / { try_files $uri $uri/ /index.html =404; }
  }
}
