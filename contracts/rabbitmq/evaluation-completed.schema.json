{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domrov.example/contracts/rabbitmq/evaluation-completed.schema.json",
  "title": "Evaluation completed payload",
  "type": "object",
  "required": ["evaluationId", "submissionId", "status", "score"],
  "properties": {
    "evaluationId": {"type": "string", "minLength": 1},
    "submissionId": {"type": "string", "minLength": 1},
    "status": {"const": "completed"},
    "score": {"type": "number", "minimum": 0},
    "feedback": {"type": "string"},
    "rubricResults": {"type": "array", "items": {"type": "object"}}
  },
  "additionalProperties": false
}
