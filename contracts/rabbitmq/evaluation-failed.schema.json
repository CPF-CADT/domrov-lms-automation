{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domrov.example/contracts/rabbitmq/evaluation-failed.schema.json",
  "title": "Evaluation failed payload",
  "type": "object",
  "required": ["evaluationId", "submissionId", "status", "failureCode", "retryable"],
  "properties": {
    "evaluationId": {"type": "string", "minLength": 1},
    "submissionId": {"type": "string", "minLength": 1},
    "status": {"const": "failed"},
    "failureCode": {"type": "string", "minLength": 1},
    "retryable": {"type": "boolean"},
    "message": {"type": "string"}
  },
  "additionalProperties": false
}
