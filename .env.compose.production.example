# Copy these Compose settings into your deployment environment.
NODE_ENV=production
BACKEND_ENV_FILE=./apps/backend/.env.production
AUTH_CORS_ORIGIN=https://domrov.app

# Use the same access secret for every service that validates access tokens.
# Generate unique random values of at least 32 characters; never use these placeholders.
JWT_ACCESS_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-unique-random-secret-at-least-32-characters

# Set this on the React container at runtime. It is public and contains no secret.
API_BASE_URL=https://api.domrov.app

# Bakong KHQR. Use your registered account ID and keep the API token secret.
BAKONG_MODE=live
BAKONG_API_URL=https://api-bakong.nbc.gov.kh/v1
BAKONG_TOKEN=replace-with-your-bakong-api-token
BAKONG_ACCOUNT_TYPE=individual
BAKONG_BANK_ACCOUNT=your-registered-bakong-account-id
BAKONG_MERCHANT_ID=
BAKONG_ACQUIRING_BANK=
MERCHANT_NAME=DOMROV
MERCHANT_CITY=PHNOM PENH
PHONE_NUMBER=

# Ollama runs outside Docker on this host; make the host API reachable to containers.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
